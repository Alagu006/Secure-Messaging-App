DB_URL=postgresql://user:password@localhost:5432/lanchat
SECRET_KEY=change-me-to-a-random-secret
HOST=0.0.0.0
PORT=8000
# Invite code required for new user registration
INVITE_CODE=change-me-to-a-secret-invite-code
# Comma-separated list of usernames allowed to call admin management endpoints
ADMIN_USERNAMES=admin
# Set to "false" to disable mDNS/Zeroconf broadcasting on untrusted networks
DISCOVERY_ENABLED=true

